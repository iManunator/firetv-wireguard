<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><corners android:radius="12dp" /><solid android:color="#FF1B1D21" /></shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/accent" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="12dp" /><solid android:color="@color/accent_dark" /></shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="3dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape><corners android:radius="12dp" /><solid android:color="@color/surface" /></shape>
    </item>
</selector>
